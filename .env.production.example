# Copy to .env.production for LOCAL Docker Compose only. Never commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DefaultConnection=Data Source=/var/lib/mpms/mpms-production.db
AllowedHosts=localhost;127.0.0.1
Demo__ReadOnly=true
# Same-origin hosting needs no CORS grant. For a separate HTTPS frontend, set:
# Cors__AllowedOrigins__0=https://portfolio.example.com
