# ASP.NET does NOT automatically load .env files. Set these in the shell/host UI,
# use the existing Development launch profile, or use dotnet user-secrets for secrets.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Data Source=mpms.db
Demo__ReadOnly=false
# Production MUST use an absolute path on its own persistent disk and exact host:
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__DefaultConnection=Data Source=/var/lib/mpms/mpms-production.db
# AllowedHosts=YOUR-SERVICE.onrender.com
# Demo__ReadOnly=true
# Cors__AllowedOrigins__0=https://YOUR-FRONTEND.example
