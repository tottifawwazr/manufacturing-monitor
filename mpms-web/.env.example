# Public BUILD-TIME settings only. Never put secrets in VITE_* variables.
# Same-origin /api also works through the existing Vite development proxy.
VITE_API_BASE_URL=/api
VITE_DEMO_READ_ONLY=false
# Separate production frontend example (rebuild after changing):
# VITE_API_BASE_URL=https://YOUR-API.example/api
# VITE_DEMO_READ_ONLY=true
